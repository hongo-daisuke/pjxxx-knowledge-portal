{
  "name": "pjxxx-knowledge-portal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:dev": "vite build --mode development",
    "build:prd": "vite build --mode production",
    "type-check": "vue-tsc --build --force",
    "lint:oxlint": "oxlint . --fix --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "aws-amplify": "^6.17.0",
    "axios": "^1.16.1",
    "dompurify": "^3.4.5",
    "element-plus": "^2.14.0",
    "humps": "^2.0.1",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/humps": "^2.0.6",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-oxlint": "^1.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^9.0.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.1"
  }
}
